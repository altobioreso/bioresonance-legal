<!doctype html>
<html lang="$lang">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>$title</title>
  <meta name="description" content="$description">
  <meta name="theme-color" content="#031526">
  <meta name="robots" content="index,follow,max-image-preview:large">
  <meta name="apple-itunes-app" content="app-id=6807718780">
  <link rel="canonical" href="$canonical">
$alternates
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Bioresonance">
  <meta property="og:title" content="$title">
  <meta property="og:description" content="$description">
  <meta property="og:url" content="$canonical">
  <meta property="og:locale" content="$locale">
$og_alternates
  <meta property="og:image" content="https://bioresonance.club/assets/landing/bioresonance-hero.webp">
  <meta property="og:image:alt" content="$hero_alt">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="$title">
  <meta name="twitter:description" content="$description">
  <meta name="twitter:image" content="https://bioresonance.club/assets/landing/bioresonance-hero.webp">
  <meta name="twitter:image:alt" content="$hero_alt">
  <link rel="icon" href="/assets/landing/bioresonance-logo.webp">
  <link rel="stylesheet" href="/styles.css">
  <script type="application/ld+json">$schema</script>
</head>
<body class="landing-body">
  <a class="skip-link" href="#top">$skip</a>
  <header class="site-header">
    <a class="site-brand" href="$page_path" aria-label="$home_label">
      <img src="/assets/landing/bioresonance-logo.webp" width="52" height="52" alt="">
      <span><strong>Bioresonance</strong><small>$tagline</small></span>
    </a>
    <nav class="site-nav" aria-label="$nav_label">
      <a href="#experience">$nav_experience</a><a href="#how-it-works">$nav_how</a><a href="#faq">$nav_faq</a><a href="#download">$nav_download</a>
    </nav>
  </header>
  <nav class="language-nav landing-section" aria-label="$languages_label">$language_links</nav>
  <main id="top" tabindex="-1">
    <section class="landing-section hero-section">
      <div class="hero-copy">
        <p class="hero-kicker"><span aria-hidden="true">✦</span> $hero_kicker</p>
        <h1>$hero_heading</h1>
        <p class="hero-lead">$hero_lead</p>
        <div class="hero-proof" aria-label="$catalog_label"><strong>$catalog_count</strong><span>$catalog_detail</span></div>
        <div class="store-row" id="download" aria-label="$store_label">$store_badge</div>
        <p class="store-note">$store_note</p>
      </div>
      <div class="hero-visual">
        <div class="hero-glow" aria-hidden="true"></div>
        <img src="/assets/landing/bioresonance-hero.webp" width="680" height="1478" alt="$hero_alt" fetchpriority="high" decoding="async">
      </div>
    </section>
    <section class="trust-strip landing-section" aria-label="$trust_label">
      <div><span aria-hidden="true">⌁</span><strong>$trust1_title</strong><small>$trust1_text</small></div>
      <div><span aria-hidden="true">◇</span><strong>$trust2_title</strong><small>$trust2_text</small></div>
      <div><span aria-hidden="true">◉</span><strong>$trust3_title</strong><small>$trust3_text</small></div>
    </section>
    <section class="landing-section intro-section" id="experience">
      <p class="section-kicker">$intro_kicker</p><h2>$intro_heading</h2><p class="section-lead">$intro_lead</p>
      <div class="feature-grid">
        <article class="feature-card feature-card-blue"><span class="feature-number">01</span><h3>$step1_heading</h3><p>$step1_text</p></article>
        <article class="feature-card"><span class="feature-number">02</span><h3>$step2_heading</h3><p>$step2_text</p></article>
        <article class="feature-card"><span class="feature-number">03</span><h3>$step3_heading</h3><p>$step3_text</p></article>
      </div>
    </section>
    <section class="immersive-section" id="how-it-works">
      <div class="landing-section immersive-inner">
        <div class="immersive-copy"><p class="section-kicker cyan">$immersive_kicker</p><h2>$immersive_heading</h2><p>$immersive_text</p>
          <ul class="check-list"><li>$check1</li><li>$check2</li><li>$check3</li><li>$check4</li></ul>
        </div>
        <div class="screenshot-stack">
          <figure class="phone-shot phone-shot-back"><img src="/assets/landing/local-ai.webp" width="520" height="1130" alt="$ai_alt" loading="lazy" decoding="async"></figure>
          <figure class="phone-shot phone-shot-front"><img src="/assets/landing/immersive-player.webp" width="520" height="1130" alt="$player_alt" loading="lazy" decoding="async"></figure>
        </div>
      </div>
    </section>
    <section class="landing-section library-section">
      <div class="library-copy"><p class="section-kicker">$library_kicker</p><h2>$library_heading</h2><p>$library_text</p></div>
      <div class="metric-grid"><article><strong>$metric1_value</strong><span>$metric1</span></article><article><strong>$metric2_value</strong><span>$metric2</span></article><article><strong>6</strong><span>$metric3</span></article><article><strong>1–5</strong><span>$metric4</span></article></div>
    </section>
    <section class="landing-section ritual-section"><div class="ritual-card"><p class="section-kicker cyan">$ritual_kicker</p><h2>$ritual_heading</h2><p>$ritual_text</p>
      <div class="ritual-tips" aria-label="$tips_label"><span>$tip1</span><span>$tip2</span><span>$tip3</span><span>$tip4</span></div>
    </div></section>
    <section class="privacy-section" id="privacy"><div class="landing-section privacy-inner"><div class="privacy-icon" aria-hidden="true">⌾</div><div>
      <p class="section-kicker cyan">$privacy_kicker</p><h2>$privacy_heading</h2><p>$privacy_text</p><a class="text-link" href="/privacy.html" hreflang="en">$privacy_link <span aria-hidden="true">→</span></a>
    </div></div></section>
    <section class="landing-section app-facts" id="about"><p class="section-kicker">$facts_kicker</p><h2>$facts_heading</h2>
      <dl>
        <div><dt>$facts_app</dt><dd>Bioresonance: Frequency Sounds</dd></div>
        <div><dt>$facts_developer</dt><dd>Boris Douarre</dd></div>
        <div><dt>$facts_devices</dt><dd>$facts_devices_value</dd></div>
        <div><dt>$facts_languages</dt><dd>$facts_languages_value</dd></div>
        <div><dt>$facts_pricing</dt><dd>$facts_pricing_value <a href="$app_store">App Store</a></dd></div>
        <div><dt>$facts_support</dt><dd><span>bioresonance528hz (at) gmail.com</span></dd></div>
      </dl>
    </section>
    <section class="landing-section faq-section" id="faq"><h2>$faq_heading</h2>$faq_html</section>
    <section class="landing-section final-cta">
      <img src="/assets/landing/bioresonance-logo.webp" width="84" height="84" alt="" loading="lazy" decoding="async">
      <p class="section-kicker">$tagline</p><h2>$final_heading</h2><p>$final_text</p>
      <div class="store-row store-row-centered" aria-label="$store_label">$store_badge</div>
    </section>
  </main>
  <footer class="site-footer"><div><a class="site-brand footer-brand" href="#top" aria-label="$back_top"><img src="/assets/landing/bioresonance-logo.webp" width="44" height="44" alt="" loading="lazy"><span><strong>Bioresonance</strong></span></a><p>$footer_notice</p></div>
    <nav aria-label="$legal_label"><a href="/privacy.html" hreflang="en">$privacy_short</a><a href="/terms.html" hreflang="en">$terms_short</a><span>bioresonance528hz (at) gmail.com</span></nav>
    <p class="copyright">$copyright</p>
  </footer>
</body>
</html>
